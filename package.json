{
  "name": "drug-logbook",
  "version": "1.0.0",
  "description": "A drug log inventory",
  "main": "index.js",
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "build": "npm --prefix client run build",
    "start": "NODE_ENV=production node server/server.js",
    "dev:server": "npm --prefix server start",
    "dev:client": "npm --prefix client run dev -- --host 0.0.0.0",
    "test": "npm --prefix server test && npm --prefix client test",
    "lint": "npm --prefix server run lint"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sashajokic74/drug-logbook.git"
  },
  "author": "Sasa Jokic",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/sashajokic74/drug-logbook/issues"
  },
  "homepage": "https://github.com/sashajokic74/drug-logbook#readme",
  "dependencies": {
    "express": "^5.2.1"
  }
}
